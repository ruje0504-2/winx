+static bool cclk_policy_is_open_loop(uint32_t policy)
+{
+	if ((policy & CCLK_POLICY_RESERVED_MASK) != 0U)
+		return false;
+	for (unsigned int shift = 0U; shift < 16U; shift += 4U) {
+		uint32_t src = (policy >> shift) & 0xfU;
+		if ((src != CCLK_POLICY_SRC_CLKM) &&
+		    (src != CCLK_POLICY_SRC_PLLX))
+			return false;
+	}
+	return true;
+}
+
+static bool cclk_policy_uses_pllx(uint32_t policy)
+{
+	for (unsigned int shift = 0U; shift < 16U; shift += 4U) {
+		if (((policy >> shift) & 0xfU) == CCLK_POLICY_SRC_PLLX)
+			return true;
+	}
+	return false;
+}
+
+bool tegra_lite_clocks_cclk_supported(void)
+{
+	uint32_t policy = cr(0x020);
+
+	if (!cclk_policy_is_open_loop(policy))
+		return false;
+	if (cclk_policy_uses_pllx(policy) && ((cr(0x0e0) & PLL_ON) == 0U))
+		return false;
+	return true;
