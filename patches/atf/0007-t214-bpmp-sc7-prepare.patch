@@ -587,6 +658,37 @@ int tegra_soc_pwr_domain_on_finish(const psci_power_state_t *target_state)
 	 */
 	tegra_fc_lock_active_cluster();
 
+#if SWITCH_LITE_SC7
+	if (tegra_chipid_is_t210_b01()) {
+		int my_cpu = plat_my_core_pos();
+
+		if ((my_cpu >= 0) && (my_cpu < PLATFORM_MAX_CPUS_PER_CLUSTER)) {
+			cpu_c7_suspended[my_cpu] = 0U;
+		}
+		if (target_state->pwr_domain_state[PLAT_MAX_PWR_LVL] ==
+				PLAT_SYS_SUSPEND_STATE_ID) {
+			static const uint8_t pg_id[4] = { 14U, 9U, 10U, 11U };
+			uint32_t pg = tegra_pmc_read_32(PMC_PWRGATE_STATUS);
+
+			for (int i = 0; i < PLATFORM_MAX_CPUS_PER_CLUSTER; i++) {
+				if ((i != my_cpu) && ((pg & (1U << pg_id[i])) == 0U)) {
+					cpu_powergate_mask[i] = 0;
+				}
+			}
+			for (int i = 0; i < PLATFORM_MAX_CPUS_PER_CLUSTER; i++) {
+				if ((i != my_cpu) && (cpu_c7_suspended[i] != 0U)) {
+					cpu_c7_suspended[i] = 0U;
+					flush_dcache_range((uintptr_t)cpu_c7_suspended,
+							   sizeof(cpu_c7_suspended));
+					(void)tegra_soc_pwr_domain_on((u_register_t)i);
+				}
+			}
+		}
+		flush_dcache_range((uintptr_t)cpu_c7_suspended,
+				   sizeof(cpu_c7_suspended));
+	}
+#endif
+
 	/*
 	 * Resume PMC hardware block for Tegra210 platforms
 	 */
@@ -617,6 +719,13 @@ int tegra_soc_pwr_domain_on(u_register_t mpidr)
 
 int tegra_soc_pwr_domain_off(const psci_power_state_t *target_state)
 {
+#if SWITCH_LITE_SC7
+	if (tegra_chipid_is_t210_b01()) {
+		cpu_c7_suspended[read_mpidr() & MPIDR_CPU_MASK] = 0U;
+		flush_dcache_range((uintptr_t)cpu_c7_suspended,
+				   sizeof(cpu_c7_suspended));
+	}
+#endif
 	tegra_fc_cpu_off(read_mpidr() & MPIDR_CPU_MASK);
 	return PSCI_E_SUCCESS;
 }
