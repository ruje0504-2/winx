@@ -280,6 +324,13 @@ int tegra_soc_pwr_domain_suspend(const psci_power_state_t *target_state)
 
 		assert(stateid_afflvl0 == PSTATE_ID_CORE_POWERDN);
 
+#if SWITCH_LITE_SC7
