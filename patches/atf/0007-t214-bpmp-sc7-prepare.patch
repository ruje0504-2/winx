@@ -287,8 +338,19 @@ int tegra_soc_pwr_domain_suspend(const psci_power_state_t *target_state)
 		/* Prepare for cluster idle */
 		tegra_fc_cluster_idle(mpidr);
 
-	} else if (stateid_afflvl0 == PSTATE_ID_CORE_POWERDN) {
+	} else if ((stateid_afflvl0 == PSTATE_ID_CORE_POWERDN)
+#if SWITCH_LITE_SC7
+		   || (stateid_afflvl0 == PLAT_MAX_OFF_STATE)
+#endif
+		  ) {
 
+#if SWITCH_LITE_SC7
+		if (tegra_chipid_is_t210_b01()) {
+			cpu_c7_suspended[mpidr & MPIDR_CPU_MASK] = 1U;
+			flush_dcache_range((uintptr_t)cpu_c7_suspended,
+					   sizeof(cpu_c7_suspended));
+		}
+#endif
 		/* Prepare for cpu powerdn */
 		tegra_fc_cpu_powerdn(mpidr);
 
@@ -491,6 +553,15 @@ int tegra_soc_pwr_domain_on_finish(const psci_power_state_t *target_state)
 			tegra_se_resume();
 		}
 
+#if SWITCH_LITE_SC7
+		if (tegra_chipid_is_t210_b01()) {
+			plat_secondary_setup();
