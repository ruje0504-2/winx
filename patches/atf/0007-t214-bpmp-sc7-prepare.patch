 		/* Restart console output. */
 		plat_enable_console(plat_params->uart_id);
@@ -190,6 +218,11 @@ static void tegra_pwr_domain_on_finish(const psci_power_state_t *target_state)
 		 * Initialize the GIC cpu and distributor interfaces
 		 */
 		tegra_gic_pcpu_init();
+#if SWITCH_LITE_SC7
+		if (tegra_chipid_is_t210_b01()) {
+			tegra_lite_gic_pcpu_restore((unsigned int)plat_my_core_pos());
+		}
