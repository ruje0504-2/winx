diff --git a/plat/nvidia/tegra/soc/t210/t214/sc7.c b/plat/nvidia/tegra/soc/t210/t214/sc7.c
new file mode 100644
index 000000000..87f9f88cc
--- /dev/null
+++ b/plat/nvidia/tegra/soc/t210/t214/sc7.c
@@ -0,0 +1,341 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-only
+ * SC7 preparation and GICv2 non-secure context recovery adapted from
+ * Switchroot L4T's pm-tegra210.c and pmc.c (commit 2d0059fd3167).
+ * Copyright (c) 2009-2019, NVIDIA CORPORATION. All rights reserved.
+ * Copyright (c) 2021-2023, CTCaer.
+ * Copyright (c) 2026, ruje0504-2.
+ *
+ * The B01 board routes MAX77620 pwr_int_n to PMC wake event 51, active low,
+ * and GIC SPI 86 (INTID 118, PMU_EXT) via PMC interrupt inversion. GIC PMU_EXT
+ * alone cannot wake a power-gated SoC, and PMC wake 51 cannot fire unless the
+ * Windows power-button driver has unmasked MAX77620 ONOFFIRQ and enabled GIC
+ * INTID 118. Also snapshot/restore non-secure GICv2 Group 1 distributor and
+ * banked per-CPU state across C7/CC6/SC7 because Windows Modern Standby enters
+ * via PSCI CPU_SUSPEND rather than Linux S3 syscore callbacks.
+ */
+#include <stdbool.h>
+#include <stdint.h>
+#include <arch_helpers.h>
+#include <bpmp.h>
+#include <drivers/delay_timer.h>
+#include <lib/mmio.h>
+#include <lib/psci/psci.h>
+#include <pmc.h>
+#include <tegra_def.h>
+
+#define LITE_PMC_SW_WAKE_STATUS		0x018U
+#define LITE_PMC_COREPWRGOOD_TIMER	0x03cU
+#define LITE_PMC_CPUPWRGOOD_TIMER	0x0c8U
+#define LITE_PMC_CPUPWROFF_TIMER	0x0ccU
+#define LITE_PMC_COREPWROFF_TIMER	0x0e0U
+#define LITE_PMC_WAKE2_MASK		0x160U
+#define LITE_PMC_WAKE2_LEVEL		0x164U
+#define LITE_PMC_WAKE2_STATUS		0x168U
+#define LITE_PMC_SW_WAKE2_STATUS	0x16cU
+
+#define LITE_PMC_LATCH_WAKEUPS		(1U << 5)
+#define LITE_PMC_PWRREQ_POL		(1U << 8)
+#define LITE_PMC_PWRREQ_OE		(1U << 9)
+#define LITE_PMC_SYSCLK_POL		(1U << 10)
+#define LITE_PMC_SYSCLK_OE		(1U << 11)
+#define LITE_PMC_SIDE_EFFECT_LP0	(1U << 14)
+#define LITE_PMC_CPU_PWRREQ_POL		(1U << 15)
+#define LITE_PMC_CPU_PWRREQ_OE		(1U << 16)
+#define LITE_PMC_INTR_POLARITY		(1U << 17)
+#define LITE_PMC_PMIC_WAKE		(1U << (51 - 32))
+
+/* Switchroot B01 NX DT core power good/off timers (13100/7800 us, 44160 us). */
+#define LITE_CORE_PWRGOOD_VAL		0x6c00U
+#define LITE_CORE_PWROFF_VAL		0x05a8U
+
+#define LITE_GICD_BASE			0x50041000U
+#define LITE_GICC_BASE			0x50042000U
+#define LITE_SYSCTR0_CNTCR		0x7000f000U
+#define LITE_GIC_PMU_EXT_INTID		118U
+#define LITE_GIC_MAX_WORDS		8U
+#define LITE_GIC_CTLR_GRP1		(1U << 1)
+#define LITE_GICC_EOI_MODE_NS		(1U << 10)
+
+struct lite_gic_pcpu {
+	uint32_t igroupr0;
+	uint32_t isenabler0;
+	uint32_t ipriorityr[8];
+	uint32_t gicc_ctlr;
+	uint32_t gicc_pmr;
+	uint32_t gicc_abpr;
+	bool valid;
+};
+
+static struct lite_gic_pcpu gic_pcpu[4];
+
+static struct {
+	uint32_t words;
+	uint32_t gicd_ctlr;
+	uint32_t pmc_cntrl;
+	uint32_t igroupr[LITE_GIC_MAX_WORDS];
+	uint32_t isenabler[LITE_GIC_MAX_WORDS];
+	uint32_t icfgr[LITE_GIC_MAX_WORDS * 2U];
+	uint32_t ipriorityr[LITE_GIC_MAX_WORDS * 8U];
+	uint32_t itargetsr[LITE_GIC_MAX_WORDS * 8U];
+	bool valid;
+} gic_dist;
+static bool sc7_armed;
+
+void tegra_lite_sc7_cancel(void)
+{
+	const uint32_t request[] = { 0U, 0U };
+	uint32_t unused_response = 0U;
+
+	if (!sc7_armed)
+		return;
+	sc7_armed = false;
+	flush_dcache_range((uintptr_t)&sc7_armed, sizeof(sc7_armed));
+	(void)tegra_bpmp_send_receive_atomic(MRQ_ENABLE_SUSPEND, request,
+			(int)sizeof(request), &unused_response, 0);
+}
+
+int32_t tegra_lite_sc7_prepare(void)
+{
+	const uint32_t request[] = { TEGRA_PM_SC7, 0U };
+	uint32_t unused_response = 0U;
+	uint32_t control, mask, level;
+	uint32_t pmu_word = LITE_GIC_PMU_EXT_INTID / 32U;
+	uint32_t pmu_bit = 1U << (LITE_GIC_PMU_EXT_INTID % 32U);
+
+	sc7_armed = false;
+	/* Require both warmboot_mariko (SCRATCH1) and bpmpfw_b01 (SCRATCH39). */
+	if ((tegra_pmc_read_32(PMC_SCRATCH1) == 0U) ||
+	    (tegra_pmc_read_32(PMC_SCRATCH39) == 0U)) {
+		return PSCI_E_NOT_SUPPORTED;
+	}
+
+	/* Require non-secure PMU_EXT (GIC INTID 118) armed by SwitchPowerButton. */
+	if (((mmio_read_32(LITE_GICD_BASE + 0x100U + pmu_word * 4U) & pmu_bit) == 0U) ||
+	    ((mmio_read_32(LITE_GICD_BASE + 0x080U + pmu_word * 4U) & pmu_bit) == 0U)) {
+		return PSCI_E_DENIED;
+	}
+
+	if (tegra_bpmp_send_receive_atomic(MRQ_ENABLE_SUSPEND, request,
+			(int)sizeof(request), &unused_response, 0) != 0) {
+		return PSCI_E_DENIED;
+	}
+	sc7_armed = true;
+
+	/* Program B01 NX core/CPU power timers and request polarities. */
+	tegra_pmc_write_32(LITE_PMC_COREPWRGOOD_TIMER, LITE_CORE_PWRGOOD_VAL);
+	tegra_pmc_write_32(LITE_PMC_COREPWROFF_TIMER, LITE_CORE_PWROFF_VAL);
+	tegra_pmc_write_32(LITE_PMC_CPUPWRGOOD_TIMER, 0U);
+	tegra_pmc_write_32(LITE_PMC_CPUPWROFF_TIMER, 0U);
+
+	control = tegra_pmc_read_32(PMC_CONFIG);
+	control &= ~(LITE_PMC_PWRREQ_POL | LITE_PMC_SYSCLK_POL |
+		     LITE_PMC_SIDE_EFFECT_LP0 | LITE_PMC_CPU_PWRREQ_POL);
+	control |= LITE_PMC_PWRREQ_OE | LITE_PMC_SYSCLK_OE |
+		   LITE_PMC_CPU_PWRREQ_OE | LITE_PMC_INTR_POLARITY;
+	tegra_pmc_write_32(PMC_CONFIG, control);
+	if (tegra_pmc_read_32(PMC_CONFIG) != control) {
+		tegra_lite_sc7_cancel();
+		return PSCI_E_DENIED;
+	}
+
+	/* Latch wake-pad state using Switchroot's two 120-us settling periods. */
+	tegra_pmc_write_32(LITE_PMC_SW_WAKE_STATUS, 0U);
+	tegra_pmc_write_32(LITE_PMC_SW_WAKE2_STATUS, 0U);
+	tegra_pmc_write_32(PMC_CONFIG, control | LITE_PMC_LATCH_WAKEUPS);
+	udelay(120);
+	tegra_pmc_write_32(PMC_CONFIG, control & ~LITE_PMC_LATCH_WAKEUPS);
+	udelay(120);
+
+	mask = tegra_pmc_read_32(LITE_PMC_WAKE2_MASK);
+	level = tegra_pmc_read_32(LITE_PMC_WAKE2_LEVEL);
+	tegra_pmc_write_32(LITE_PMC_WAKE2_STATUS, LITE_PMC_PMIC_WAKE);
+	tegra_pmc_write_32(LITE_PMC_WAKE2_LEVEL, level & ~LITE_PMC_PMIC_WAKE);
+	tegra_pmc_write_32(LITE_PMC_WAKE2_MASK, mask | LITE_PMC_PMIC_WAKE);
+	if (((tegra_pmc_read_32(LITE_PMC_WAKE2_MASK) & LITE_PMC_PMIC_WAKE) == 0U) ||
+	    ((tegra_pmc_read_32(LITE_PMC_WAKE2_LEVEL) & LITE_PMC_PMIC_WAKE) != 0U)) {
+		tegra_lite_sc7_cancel();
+		return PSCI_E_DENIED;
+	}
+
+	flush_dcache_range((uintptr_t)&sc7_armed, sizeof(sc7_armed));
+	return PSCI_E_SUCCESS;
+}
+
+void tegra_lite_gic_pcpu_invalidate(unsigned int cpu)
+{
+	if (cpu < 4U) {
+		gic_pcpu[cpu].valid = false;
+		flush_dcache_range((uintptr_t)&gic_pcpu[cpu], sizeof(gic_pcpu[cpu]));
+	}
+}
+
+void tegra_lite_gic_pcpu_save(unsigned int cpu)
+{
+	struct lite_gic_pcpu *c;
+
+	if (cpu >= 4U) {
+		return;
+	}
+	c = &gic_pcpu[cpu];
+	c->valid = false;
+	c->igroupr0 = mmio_read_32(LITE_GICD_BASE + 0x080U);
+	c->isenabler0 = mmio_read_32(LITE_GICD_BASE + 0x100U);
+	for (unsigned int i = 0U; i < 8U; i++) {
+		c->ipriorityr[i] = mmio_read_32(LITE_GICD_BASE + 0x400U + i * 4U);
+	}
+	c->gicc_ctlr = mmio_read_32(LITE_GICC_BASE + 0x000U);
+	c->gicc_pmr = mmio_read_32(LITE_GICC_BASE + 0x004U);
+	c->gicc_abpr = mmio_read_32(LITE_GICC_BASE + 0x01cU);
+	c->valid = true;
+	flush_dcache_range((uintptr_t)c, sizeof(*c));
+}
+
+void tegra_lite_gic_pcpu_restore(unsigned int cpu)
+{
+	struct lite_gic_pcpu *c;
+	uint32_t ns, ctlr;
+
+	if ((cpu >= 4U) || !gic_pcpu[cpu].valid) {
+		return;
+	}
+	c = &gic_pcpu[cpu];
+	c->valid = false;
+	ns = c->igroupr0;
+
+	mmio_write_32(LITE_GICD_BASE + 0x080U,
+		      mmio_read_32(LITE_GICD_BASE + 0x080U) | ns);
+	for (unsigned int i = 0U; i < 8U; i++) {
+		uint32_t bmask = 0U;
+		for (unsigned int b = 0U; b < 4U; b++) {
+			if ((ns & (1U << (i * 4U + b))) != 0U) {
+				bmask |= 0xffU << (b * 8U);
+			}
+		}
+		if (bmask != 0U) {
+			uintptr_t reg = LITE_GICD_BASE + 0x400U + i * 4U;
+			mmio_write_32(reg, (mmio_read_32(reg) & ~bmask) |
+					   (c->ipriorityr[i] & bmask));
+		}
+	}
+	if ((ns & c->isenabler0) != 0U) {
+		mmio_write_32(LITE_GICD_BASE + 0x100U, ns & c->isenabler0);
+	}
+	mmio_write_32(LITE_GICC_BASE + 0x01cU, c->gicc_abpr);
+	mmio_write_32(LITE_GICC_BASE + 0x004U, c->gicc_pmr);
+	ctlr = mmio_read_32(LITE_GICC_BASE + 0x000U);
+	ctlr &= ~(LITE_GIC_CTLR_GRP1 | LITE_GICC_EOI_MODE_NS);
+	ctlr |= c->gicc_ctlr & (LITE_GIC_CTLR_GRP1 | LITE_GICC_EOI_MODE_NS);
+	mmio_write_32(LITE_GICC_BASE + 0x000U, ctlr);
+	dsbsy();
+	flush_dcache_range((uintptr_t)c, sizeof(*c));
+}
+
+void tegra_lite_gic_dist_save(void)
+{
+	uint32_t words = (mmio_read_32(LITE_GICD_BASE + 0x004U) & 0x1fU) + 1U;
+
+	if (words > LITE_GIC_MAX_WORDS) {
+		words = LITE_GIC_MAX_WORDS;
+	}
+	sc7_armed = false;
+	flush_dcache_range((uintptr_t)&sc7_armed, sizeof(sc7_armed));
+	gic_dist.valid = false;
+	gic_dist.words = words;
+	gic_dist.gicd_ctlr = mmio_read_32(LITE_GICD_BASE + 0x000U);
+	gic_dist.pmc_cntrl = tegra_pmc_read_32(PMC_CONFIG);
+	for (uint32_t w = 1U; w < words; w++) {
+		gic_dist.igroupr[w] = mmio_read_32(LITE_GICD_BASE + 0x080U + w * 4U);
+		gic_dist.isenabler[w] = mmio_read_32(LITE_GICD_BASE + 0x100U + w * 4U);
+		gic_dist.icfgr[w * 2U] =
+			mmio_read_32(LITE_GICD_BASE + 0xc00U + (w * 2U) * 4U);
+		gic_dist.icfgr[w * 2U + 1U] =
+			mmio_read_32(LITE_GICD_BASE + 0xc00U + (w * 2U + 1U) * 4U);
+		for (uint32_t sub = 0U; sub < 8U; sub++) {
+			uint32_t idx = w * 8U + sub;
+			gic_dist.ipriorityr[idx] =
+				mmio_read_32(LITE_GICD_BASE + 0x400U + idx * 4U);
+			gic_dist.itargetsr[idx] =
+				mmio_read_32(LITE_GICD_BASE + 0x800U + idx * 4U);
+		}
+	}
+	gic_dist.valid = true;
+	flush_dcache_range((uintptr_t)&gic_dist, sizeof(gic_dist));
+}
+
+void tegra_lite_gic_dist_restore(void)
+{
+	uint32_t ctlr, cntcr;
+
+	/* Re-enable system counter before returning to non-secure OS timers. */
+	cntcr = mmio_read_32(LITE_SYSCTR0_CNTCR);
+	mmio_write_32(LITE_SYSCTR0_CNTCR, cntcr | 0x3U);
+
+	if (!gic_dist.valid) {
+		return;
+	}
+	sc7_armed = false;
+	flush_dcache_range((uintptr_t)&sc7_armed, sizeof(sc7_armed));
+	gic_dist.valid = false;
+
+	/* Preserve PMIC active-low -> GIC high inversion before unmasking SPI 86. */
+	if ((gic_dist.pmc_cntrl & LITE_PMC_INTR_POLARITY) != 0U) {
+		tegra_pmc_write_32(PMC_CONFIG,
+			tegra_pmc_read_32(PMC_CONFIG) | LITE_PMC_INTR_POLARITY);
+	}
+
+	ctlr = mmio_read_32(LITE_GICD_BASE + 0x000U);
+	mmio_write_32(LITE_GICD_BASE + 0x000U, ctlr & ~LITE_GIC_CTLR_GRP1);
+
+	for (uint32_t w = 1U; w < gic_dist.words; w++) {
+		uint32_t sec_grp0 = ~mmio_read_32(LITE_GICD_BASE + 0x080U + w * 4U);
+		uint32_t ns = gic_dist.igroupr[w] & ~sec_grp0;
+
+		mmio_write_32(LITE_GICD_BASE + 0x080U + w * 4U,
+			      mmio_read_32(LITE_GICD_BASE + 0x080U + w * 4U) | ns);
+
+		for (uint32_t half = 0U; half < 2U; half++) {
+			uint32_t cmask = 0U;
+			for (uint32_t b = 0U; b < 16U; b++) {
+				if ((ns & (1U << (half * 16U + b))) != 0U) {
+					cmask |= 0x3U << (b * 2U);
+				}
+			}
+			if (cmask != 0U) {
+				uint32_t cidx = w * 2U + half;
+				uintptr_t reg = LITE_GICD_BASE + 0xc00U + cidx * 4U;
+				mmio_write_32(reg, (mmio_read_32(reg) & ~cmask) |
+						   (gic_dist.icfgr[cidx] & cmask));
+			}
+		}
+
+		for (uint32_t sub = 0U; sub < 8U; sub++) {
+			uint32_t bmask = 0U;
+			for (uint32_t b = 0U; b < 4U; b++) {
+				if ((ns & (1U << (sub * 4U + b))) != 0U) {
+					bmask |= 0xffU << (b * 8U);
+				}
+			}
+			if (bmask != 0U) {
+				uint32_t idx = w * 8U + sub;
+				uintptr_t preg = LITE_GICD_BASE + 0x400U + idx * 4U;
+				uintptr_t treg = LITE_GICD_BASE + 0x800U + idx * 4U;
+				mmio_write_32(preg, (mmio_read_32(preg) & ~bmask) |
+						    (gic_dist.ipriorityr[idx] & bmask));
+				mmio_write_32(treg, (mmio_read_32(treg) & ~bmask) |
+						    (gic_dist.itargetsr[idx] & bmask));
+			}
+		}
+
+		if ((ns & gic_dist.isenabler[w]) != 0U) {
+			mmio_write_32(LITE_GICD_BASE + 0x100U + w * 4U,
+				      ns & gic_dist.isenabler[w]);
+		}
+	}
+
+	ctlr = mmio_read_32(LITE_GICD_BASE + 0x000U);
+	mmio_write_32(LITE_GICD_BASE + 0x000U,
+		      ctlr | (gic_dist.gicd_ctlr & LITE_GIC_CTLR_GRP1));
+	dsbsy();
+	flush_dcache_range((uintptr_t)&gic_dist, sizeof(gic_dist));
+}
